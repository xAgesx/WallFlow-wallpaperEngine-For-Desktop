{
  "name": "wallflow",
  "productName": "WallFlow",
  "version": "1.0.1",
  "description": "Lightweight animated wallpaper engine",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "gen-icon": "electron tools/gen-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wallflow.app",
    "productName": "WallFlow",
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "xAgesx",
      "repo": "WallFlow-wallpaperEngine-For-Desktop"
    }
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "electron-updater": "^6.8.11"
  }
}
