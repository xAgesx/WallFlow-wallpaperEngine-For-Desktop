# WallFlow API keys
# Copy this file to .env (which is gitignored) and fill in the keys you have.
# On Vercel, add these SAME variable names under
# Project Settings > Environment Variables instead of a .env file.
# Never commit .env - it must also stay out of packaged builds.

# https://wallhaven.cc/settings/api-keys
WALLHAVEN_API_KEY=

# https://www.pexels.com/api/
PEXELS_API_KEY=

# https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=

# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# https://tenor.com/gifapi
TENOR_API_KEY=
