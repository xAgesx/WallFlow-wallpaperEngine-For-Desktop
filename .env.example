# WallFlow API keys
# Copy this file to .env (which is gitignored) and fill in the keys you have.
# Never commit .env - it must also stay out of packaged builds.

# --- Option A: direct mode (default) ---
# Put provider keys here and the app calls each API directly.
# These are read from .env in development; in a packaged build they are read
# from real environment variables of the same names.

# https://wallhaven.cc/settings/api-keys
WALLHAVEN_API_KEY=

# https://www.pexels.com/api/
PEXELS_API_KEY=

# https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=

# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# https://tenor.com/gifapi
TENOR_API_KEY=

# --- Option B: key proxy (keys stay on the server) ---
# Deploy api/proxy.js (for example to Vercel) and set the FIVE keys above as
# environment variables on that host (Project Settings > Environment Variables).
# Then point the app at it. When this is set, the app routes all keyed API
# calls through the proxy and ships without any key inside the client.
#
# In development, set it here. In a packaged build, set PROXY_URL in
# src/main/config.js (it ships with the app) or export WALLFLOW_PROXY_URL.
# Leave empty to use direct mode above.
WALLFLOW_PROXY_URL=
